    "endpoint": "query", "table": "clicks", "operations": [{"method": "select", "args": ["page"]}, {"method": "timeRange", "args": ["ts", "2026-01-01T07:00:00.123456789-05:00", "2026-02-01T00:00:00Z"]}],
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_content_type": "application/json",
    "expected_body": {"columns": ["page"], "limit": 1000, "time_range": {"column": "ts", "since": "2026-01-01T07:00:00.123456789-05:00", "until": "2026-02-01T00:00:00Z"}}
  },
  {
    "name": "js: last sends a duration string as given",
    "sdks": ["js"],
    "endpoint": "query", "table": "clicks", "operations": [{"method": "select", "args": ["page"]}, {"method": "last", "args": ["ts", "7d"]}],
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_content_type": "application/json",
    "expected_body": {"columns": ["page"], "limit": 1000, "time_range": {"column": "ts", "since": "7d"}}
  },
  {
    "name": "js: last sends milliseconds as a duration string",
    "sdks": ["js"],
    "endpoint": "query", "table": "clicks", "operations": [{"method": "select", "args": ["page"]}, {"method": "last", "args": ["ts", 90000]}],
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_content_type": "application/json",
    "expected_body": {"columns": ["page"], "limit": 1000, "time_range": {"column": "ts", "since": "90000ms"}}
  },
  {
    "name": "per-call header on a query",
    "endpoint": "query", "table": "clicks", "operations": [{"method": "limit", "args": [100]}], "call_headers": {"X-Trace": "t-1"},
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_content_type": "application/json",
    "expected_headers": {"X-Trace": "t-1"}, "expected_body": {"select_all": true, "limit": 100}
  },
  {
    "name": "per-call header replaces a client header case-insensitively",
    "endpoint": "query", "table": "clicks", "operations": [{"method": "limit", "args": [100]}], "headers": {"X-Trace-Id": "one"}, "call_headers": {"x-trace-id": "two"},
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_headers": {"X-Trace-Id": "two"},
    "expected_body": {"select_all": true, "limit": 100}
  },
  {
    "name": "per-call header cannot replace the SDK's own Content-Type or Accept",
    "endpoint": "query", "table": "clicks", "operations": [{"method": "limit", "args": [100]}], "call_headers": {"Content-Type": "text/nope", "Accept": "text/nope", "X-Trace": "t-1"},
    "expected_path": "/v1/query?table=clicks", "expected_method": "POST", "expected_content_type": "application/json",
    "expected_headers": {"Accept": "application/json", "X-Trace": "t-1"}, "expected_body": {"select_all": true, "limit": 100}
  },
  {
    "name": "per-call header on ingest",
    "endpoint": "ingest", "table": "clicks", "operations": [{"method": "insert", "args": [{"page": "/a"}]}], "call_headers": {"X-Trace": "t-1"},
    "expected_path": "/v1/ingest?table=clicks", "expected_method": "POST",
    "expected_headers": {"X-Trace": "t-1"}, "expected_ndjson": [{"page": "/a"}]
  },
  {
    "name": "per-call header on a pipe",
    "endpoint": "pipe", "pipe_name": "simple", "pipe_params": null, "call_headers": {"X-Trace": "t-1"},
    "expected_path": "/v1/pipes/simple", "expected_method": "POST", "expected_headers": {"X-Trace": "t-1"},
    "expected_body": {}
  },
  {
    "name": "per-call header on raw SQL",
    "endpoint": "sql", "sql": "SELECT 1", "call_headers": {"X-Trace": "t-1"},
    "expected_path": "/v1/ops/query", "expected_method": "POST", "expected_headers": {"X-Trace": "t-1"},
    "expected_body": {"sql": "SELECT 1"}
  }
]
